# Base RPC endpoint. Defaults to https://mainnet.base.org when unset (heavily rate limited).
BASE_RPC_URL=https://base-rpc.publicnode.com

# Pair to analyze (defaults: canonical WETH and native USDC on Base).
WETH_ADDRESS=0x4200000000000000000000000000000000000006
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Optional KyberSwap aggregator settings.
# KYBER_CLIENT_ID=base-depth-analysis
# KYBER_EXCLUDE_RFQ=true
# KYBER_ONLY_DIRECT=false
# KYBER_GAS_INCLUDE=false

# Optional TesseraSwap overrides (defaults are the live Base contracts).
# TESSERA_SWAP=0x55555522005BcAE1c2424D474BfD5ed477749E3e
# TESSERA_SENDER=0x0000000000000000000000000000000000000001
